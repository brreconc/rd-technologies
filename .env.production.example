# ============================================================================
# R&D Technologies — Variables para el DESPLIEGUE en producción (Docker).
# Copia este archivo a `.env` (junto a docker-compose.yml) y rellena los valores.
# NUNCA subas el `.env` real al repositorio.
# ============================================================================

# ----------------------------------------------------------------------------
# BUILD-TIME  ⚠️  (Next las hornea durante `next build`; docker-compose las pasa
# como build args). Si las cambias, hay que RECONSTRUIR la imagen (--build).
# ----------------------------------------------------------------------------

# Dominio público REAL del sitio (sin barra final). Afecta a canonical, Open
# Graph, JSON-LD, sitemap y robots.
NEXT_PUBLIC_SITE_URL="https://www.rdtechnologies.com"

# Activa la indexación en buscadores. En producción: "true".
# (Dejar en "false" bloquea el rastreo — útil para entornos de staging.)
NEXT_PUBLIC_SITE_INDEXABLE="true"

# ----------------------------------------------------------------------------
# RUNTIME (secretos de servidor; NO se hornean, se leen al arrancar el
# contenedor). Cambiarlos NO requiere reconstruir la imagen, solo reiniciar.
# ----------------------------------------------------------------------------

# Puerto del host donde publicar la app (dentro del contenedor siempre es 3000).
APP_PORT="3000"

# Envío de email del formulario de contacto (p. ej. Resend). OPCIONALES: sin
# ellos, el formulario registra en log en vez de enviar correo.
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
