# ============================================================================
# R&D Technologies — Variables de entorno (ejemplo)
# Copia este archivo a `.env.local` y ajusta los valores. NUNCA subas `.env.local`.
# ============================================================================

# URL pública del sitio (usada en metadata, canonical, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Política de indexación (§12, ADR-008). Por defecto NO indexable en local.
# Poner en "true" SOLO en el despliegue real para activar indexación (activa
# meta robots index, robots.txt Allow y el sitemap con URLs).
# NEXT_PUBLIC_SITE_INDEXABLE="false"

# ----------------------------------------------------------------------------
# Integraciones futuras (aún NO activas en la fase local). Documentadas aquí
# para que otro desarrollador sepa qué se conectará más adelante.
# ----------------------------------------------------------------------------

# Envío de correo del formulario de contacto (Fase 4 — p. ej. Resend).
# RESEND_API_KEY=""
# CONTACT_TO_EMAIL=""

# Verificación anti-bot (Fase 4 — p. ej. Cloudflare Turnstile).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# Analítica (opcional, desactivada en local).
# NEXT_PUBLIC_ANALYTICS_ID=""
